# LLM Provider Configuration
# Set LLM_PROVIDER to "mock" for offline deterministic testing and local development
LLM_PROVIDER=mock

# If using OpenAI / Compatible endpoint:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# If using Anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# System Limits and Budgets
DEFAULT_TOKEN_BUDGET=4000
MAX_OUTPUT_TOKENS=1024
SANDBOX_TIMEOUT_SECONDS=15
ENABLE_SAFE_SUBPROCESS_FALLBACK=true
